{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "adoOrgUrl": { "value": "${ADO_ORG_URL}" },
    "adminUpn": { "value": "${ADMIN_UPN}" },
    "portalClientId": { "value": "${PORTAL_CLIENT_ID=}" },
    "adminObjectId": { "value": "${ADMIN_OBJECT_ID=}" },
    "realtimeSku": { "value": "${REALTIME_SKU=DataZoneStandard}" },
    "chatCapacity": { "value": "${CHAT_CAPACITY=100}" },
    "realtimeCapacity": { "value": "${REALTIME_CAPACITY=10}" },
    "decisionCapacity": { "value": "${DECISION_CAPACITY=100}" },
    "voiceRoute": { "value": "${VOICE_ROUTE=Direct}" },
    "mediaHostEnabled": { "value": "${MEDIA_HOST_ENABLED=false}" },
    "mediaVmSize": { "value": "${MEDIA_VM_SIZE=Standard_D4s_v5}" },
    "mediaVmImageSku": { "value": "${MEDIA_VM_IMAGE_SKU=2022-datacenter}" },
    "mediaVaultPurgeProtection": { "value": "${MEDIA_VAULT_PURGE_PROTECTION=true}" },
    "mediaServiceFqdn": { "value": "${MEDIA_SERVICE_FQDN=}" },
    "bridgeMode": { "value": "${BRIDGE_MODE=Acs}" },
    "boardMode": { "value": "${BOARD_MODE=Share}" }
  }
}
