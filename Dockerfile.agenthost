# Builds the Foundry hosted agent image (ADR 0021). Build context is the repository root. The platform fixes the port at 8088.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/Zava.Scrum.AgentHost/ src/Zava.Scrum.AgentHost/
RUN dotnet publish src/Zava.Scrum.AgentHost -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8088
EXPOSE 8088
ENTRYPOINT ["dotnet", "Zava.Scrum.AgentHost.dll"]
