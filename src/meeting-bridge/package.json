{
  "name": "meeting-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "esbuild src/web/room.ts src/web/teams.ts src/web/mic-worklet.ts --bundle --format=esm --target=es2022 --outdir=public --sourcemap",
    "dev": "npm run build:web && tsx watch src/index.ts",
    "start": "npm run build:web && tsx src/index.ts",
    "build": "npm run build:web && tsc -p tsconfig.json",
    "test": "node --import tsx --test src/domain/cast.test.ts src/domain/pauses.test.ts",
    "e2e": "node --import tsx --test e2e/standup.e2e.ts",
    "e2e:retro": "node --import tsx --test e2e/retro.e2e.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.17.0",
    "@opentelemetry/api": "^1.9.0",
    "@azure/communication-calling": "^2.0.0",
    "@azure/communication-common": "^2.5.0",
    "@azure/communication-identity": "^2.0.0",
    "@azure/identity": "^4.14.1",
    "yaml": "^2.9.1",
    "playwright-core": "^1.65.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
