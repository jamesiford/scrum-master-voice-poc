{
  "type": "AdaptiveCard",
  "version": "1.5",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "body": [
    { "type": "TextBlock", "text": "${title}", "weight": "Bolder", "size": "Medium", "color": "Accent", "wrap": true },
    { "type": "TextBlock", "text": "${text}", "wrap": true },
    { "type": "FactSet", "id": "facts", "facts": [] }
  ]
}