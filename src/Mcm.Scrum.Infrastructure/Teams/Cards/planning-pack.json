{
  "type": "AdaptiveCard",
  "version": "1.5",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "body": [
    { "type": "TextBlock", "text": "${title}", "weight": "Bolder", "size": "Medium", "wrap": true },
    { "type": "TextBlock", "text": "${text}", "wrap": true },
    { "type": "FactSet", "id": "facts", "facts": [] }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Approve plan", "verb": "approve-plan", "style": "positive", "data": { "packId": "${followUpId}" } },
    { "type": "Action.Execute", "title": "Reject", "verb": "reject-plan", "style": "destructive", "data": { "packId": "${followUpId}" } }
  ]
}
